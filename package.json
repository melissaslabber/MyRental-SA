{
  "name": "myrental-sa",
  "private": true,
  "version": "1.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-document-shop.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@supabase/supabase-js": "2.116.0",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.45.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "0.5.11"
  }
}
